{
  "name": "mi-arbol-familiar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "functions"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run tests/domain.test.ts tests/photos.test.ts tests/draft.test.ts tests/tree.test.tsx tests/admin.test.tsx tests/tree-layout.test.ts",
    "test:emulators": "node scripts/test-emulators.mjs",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-mi-arbol",
    "format": "prettier --write --ignore-unknown src functions/src scripts tests *.ts *.json *.rules .github/workflows/*.yml README.md",
    "local:backend": "node scripts/local-backend.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.9.0",
    "elkjs": "^0.12.1",
    "firebase": "^13.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "firebase-tools": "^15.36.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
